{
  "name": "gladys-jung-home",
  "version": "0.1.0",
  "private": true,
  "description": "Gladys Assistant external integration for JUNG HOME installations, through the local API of the JUNG HOME gateway: lights, dimmers, covers, sockets, room thermostats, rocker buttons, sensors and scenes; stops never held back, certificate pinned. Unofficial, not affiliated with JUNG.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-timeout=60000",
    "audit": "npm audit --omit=dev",
    "cover": "node scripts/cover.mjs cover.png",
    "validate:manifest": "npx --yes github:GladysAssistant/integration-store ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "license": "Apache-2.0"
}
